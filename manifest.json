{
  "manifest_version": 3,
  "name": "WhatsApp翻译无忧",
  "description": "Translate WhatsApp Web messages inside chat bubbles with Google, DeepSeek, or OpenAI-compatible APIs.",
  "version": "0.3.3",
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp翻译无忧"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://api.mymemory.translated.net/*",
    "https://edge.microsoft.com/*",
    "https://api-edge.cognitive.microsofttranslator.com/*",
    "https://api.deepseek.com/*",
    "https://api.x.ai/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "diagnostics.js",
        "chat-tools.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
